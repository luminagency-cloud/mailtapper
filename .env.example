# --- Database (vanilla Postgres URL). Neon is fine locally.
# Production uses local Postgres 16 on the VM; see README "Hosting & deployment". ---
DATABASE_URL=postgres://user:pass@host/db

# --- Master key encryption key (KEK). 32 random bytes, base64. Generate with:
#     openssl rand -base64 32
# Keep this STABLE across restarts or stored mailbox credentials become unreadable.
MAILTAPPER_KEK_B64=

# --- HMAC secret for signing opaque message `id` locators. 32+ random bytes, base64. ---
MAILTAPPER_LOCATOR_SECRET=

# --- Server ---
PORT=3000
# Placeholder for local use. Production is https://mailtapper.luminagency.com/ (see README "Hosting & deployment").
PUBLIC_BASE_URL=https://api.yourdomain.com/
LOG_LEVEL=info

# --- Cache (thin, in-memory) ---
CACHE_TTL_SECONDS=60

# --- Default tier for the seeded tenant (free|pro|scale) ---
DEFAULT_TIER=pro

# --- Outbound SMTP defaults (used when a connection enables send without its own SMTP host) ---
# StackMail (20i / StackDNS): smtp.stackmail.com, 587, STARTTLS, full email address as username.
# Per-mailbox username and password are NOT env vars. They are stored encrypted on the
# connection (smtp_username / smtp_password, falling back to the IMAP login).
# Override host/port/tls on the connection when a mailbox uses a different server.
SMTP_DEFAULT_HOST=smtp.stackmail.com
SMTP_DEFAULT_PORT=587
SMTP_DEFAULT_TLS_MODE=starttls
